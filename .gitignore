# Python
__pycache__/
*.pyc
*.pyo

# Build / packaging artifacts (regenerated by `uv build` / `pip wheel`)
build/
dist/
*.egg-info/
*.whl

# Virtual environment (regenerate with: uv venv && uv pip install ...)
.venv/

# Large binary ephemerides (download at runtime; see force_assist.py)
ephem/

# EFCC18 star-catalog debias tables (download at runtime; see debias.py)
debias/

# find_orb reference clone (GPL-2.0; read-only oracle, not our code).
# Re-fetch from https://github.com/Bill-Gray/find_orb if needed.
find_orb/
fo.tar.gz


# OS cruft
.DS_Store

.claude/scheduled_tasks.lock
.claude

ident_check_in*
ident_check_out*

consolidation_instruction.txt

itf-obj*

ift outline/
.env
# jsdom & friends for the web UI DOM tests (npm i jsdom) -- dev-local only
node_modules/
package.json
package-lock.json

# itfprio campaign output (training store, models, review packets) -- itfprio/README.md
/runs/

.metadata_never_index
# hyperlinc campaign outputs (regenerable)
hyperlinc_candidates/
hyperlinc_2008_2026/
# agent memory export, handed between Claude Code instances -- memory-export/instructions.md
memory-export/

# local persistent storage (LOCAL_PERSISTENT_FOLDER default) -- src/pyroorb/localstore.py
.local_persistent/

# digest2 writes a parsed-model cache beside its CSV on first load (regenerable)
src/pyroorb/digest2/data/*.npz
